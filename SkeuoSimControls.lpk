<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="5">
    <Name Value="SkeuoSimControls"/>
    <Type Value="RunAndDesignTime"/>
    <CompilerOptions>
      <Version Value="11"/>
      <PathDelim Value="\"/>
      <SearchPaths>
        <OtherUnitFiles Value="source"/>
        <UnitOutputDirectory Value="lib\$(TargetCPU)-$(TargetOS)"/>
      </SearchPaths>
    </CompilerOptions>
    <Files>
      <Item>
        <Filename Value="source/SimRegister.pas"/>
        <HasRegisterProc Value="True"/>
        <UnitName Value="SimRegister"/>
      </Item>
      <Item>
        <Filename Value="source/SimBase.pas"/>
        <UnitName Value="SimBase"/>
      </Item>
      <Item>
        <Filename Value="source/SimUtils.pas"/>
        <UnitName Value="SimUtils"/>
      </Item>
      <Item>
        <Filename Value="source/SimIndicators.pas"/>
        <UnitName Value="SimIndicators"/>
      </Item>
      <Item>
        <Filename Value="source/SimInputs.pas"/>
        <UnitName Value="SimInputs"/>
      </Item>
      <Item>
        <Filename Value="source/SimGauges.pas"/>
        <UnitName Value="SimGauges"/>
      </Item>
      <Item>
        <Filename Value="source/SimAvionics.pas"/>
        <UnitName Value="SimAvionics"/>
      </Item>
      <Item>
        <Filename Value="source/SimContainers.pas"/>
        <UnitName Value="SimContainers"/>
      </Item>
      <Item>
        <Filename Value="SkeuoSimControls.rc"/>
        <Type Value="Text"/>
      </Item>
      <Item>
        <Filename Value="source/simfader.pas"/>
        <UnitName Value="simfader"/>
      </Item>
      <Item>
        <Filename Value="source/simpushbutton.pas"/>
        <UnitName Value="simpushbutton"/>
      </Item>
      <Item>
        <Filename Value="source/simledbargraph.pas"/>
        <UnitName Value="simledbargraph"/>
      </Item>
      <Item>
        <Filename Value="source/simoscilloscope.pas"/>
        <UnitName Value="simoscilloscope"/>
      </Item>
      <Item>
        <Filename Value="source/simradarscreen.pas"/>
        <UnitName Value="simradarscreen"/>
      </Item>
      <Item>
        <Filename Value="source/simmatrixpad.pas"/>
        <UnitName Value="simmatrixpad"/>
      </Item>
      <Item>
        <Filename Value="source/simselectorswitch.pas"/>
        <UnitName Value="simselectorswitch"/>
      </Item>
      <Item>
        <Filename Value="source/simthrottlelever.pas"/>
        <UnitName Value="simthrottlelever"/>
      </Item>
      <Item>
        <Filename Value="source/simjoystick.pas"/>
        <UnitName Value="simjoystick"/>
      </Item>
      <Item>
        <Filename Value="source/simlcddisplay.pas"/>
        <UnitName Value="simlcddisplay"/>
      </Item>
      <Item>
        <Filename Value="source/simsafetyswitch.pas"/>
        <UnitName Value="simsafetyswitch"/>
      </Item>
      <Item>
        <Filename Value="source/simaudiojack.pas"/>
        <UnitName Value="simaudiojack"/>
      </Item>
    </Files>
    <RequiredPkgs>
      <Item>
        <PackageName Value="BGRABitmapPack"/>
      </Item>
      <Item>
        <PackageName Value="LCL"/>
      </Item>
      <Item>
        <PackageName Value="FCL"/>
      </Item>
    </RequiredPkgs>
    <UsageOptions>
      <UnitPath Value="$(PkgOutDir)"/>
    </UsageOptions>
    <PublishOptions>
      <Version Value="2"/>
      <UseFileFilters Value="True"/>
    </PublishOptions>
  </Package>
</CONFIG>
